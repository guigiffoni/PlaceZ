# Copie para .env e preencha os valores. Nunca versione o .env real.
PORT=3000
NODE_ENV=development

# Oracle Autonomous Database com one-way TLS via ACL.
# Use o usuário da aplicação (não use ADMIN).
DB_USER=placez
DB_PASSWORD=troque-esta-senha

# Connection string TLS do serviço _high, em uma única linha.
# Mantenha as aspas simples para preservar as aspas duplas do ssl_server_cert_dn.
DB_CONNECT_STRING='(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=SEU_HOST))(connect_data=(service_name=SEU_SERVICO))(security=(ssl_server_cert_dn="CN=SEU_HOST")))'

DB_POOL_MIN=1
DB_POOL_MAX=4

# Sessão opaca: validade em dias.
SESSION_TTL_DAYS=30

# Custo do bcrypt (decisão fechada: 10).
BCRYPT_COST=10
